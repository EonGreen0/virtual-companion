# DeepSeek API 配置（必填，填你自己的 key）
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 本地 Ollama（embedding）
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3

# 网关服务端口（LobeHub 里把 DeepSeek 的 Base URL 指向这里）
GATEWAY_PORT=8080

# 恋人名称（用于记忆提取时的对话标注，可换成任意角色名）
COMPANION_NAME=AI

# 可选：网关 API Key（设置后，LobeHub 的 DeepSeek API Key 也必须填这个值）
# 留空 = 不鉴权（仅适合纯本地使用）
# GATEWAY_API_KEY=

# 记忆检索参数
MEMORY_TOP_K=8
MEMORY_SIMILARITY_THRESHOLD=0.30
